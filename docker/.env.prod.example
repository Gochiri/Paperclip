# Required — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Required — generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Recommended for Let's Encrypt rate-limit avoidance
ACME_EMAIL=admin@korvance.com

# Optional adapter API keys (omit if you only use external/remote agents)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
